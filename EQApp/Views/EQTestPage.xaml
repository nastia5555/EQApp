<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EQApp.Views.EQTestPage"
             Title="Тест на EQ"
             BackgroundColor="#F8F9FA">

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- Прогресс -->
		<Border BackgroundColor="#FFFFFF"
                Padding="15"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 0">
			<Grid ColumnDefinitions="*,Auto">
				<Label x:Name="ProgressLabel"
                       Text="Вопрос 1 из 10"
                       FontSize="14"
                       TextColor="#6C757D"/>
				<Label x:Name="ScoreLabel"
                       Text="Баллов: 0"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="#4A90E2"
                       Grid.Column="1"/>
			</Grid>
		</Border>

		<!-- Вопрос и варианты ответов -->
		<ScrollView Grid.Row="1">
			<VerticalStackLayout Spacing="20" Padding="20">

				<!-- Карточка вопроса -->
				<Border BackgroundColor="#FFFFFF"
                        StrokeShape="RoundRectangle 15"
                        Padding="20"
                        StrokeThickness="0">
					<Label x:Name="QuestionLabel"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#2C3E50"/>
				</Border>

				<!-- Варианты ответов -->
				<Border BackgroundColor="#FFFFFF"
                        StrokeShape="RoundRectangle 15"
                        Padding="15"
                        StrokeThickness="0">
					<VerticalStackLayout x:Name="OptionsStack"
                                         Spacing="12"/>
				</Border>

			</VerticalStackLayout>
		</ScrollView>

		<!-- Кнопки навигации -->
		<Grid Grid.Row="2"
              ColumnDefinitions="*,*"
              Padding="20"
              ColumnSpacing="15">

			<Button x:Name="PrevButton"
                    Text="◀ Назад"
                    BackgroundColor="#E9ECEF"
                    TextColor="#2C3E50"
                    CornerRadius="12"
                    HeightRequest="50"
                    FontSize="16"
                    IsVisible="False"
                    Clicked="OnPrevClicked"/>

			<Button x:Name="NextButton"
                    Text="Далее ▶"
                    BackgroundColor="#4A90E2"
                    TextColor="White"
                    CornerRadius="12"
                    HeightRequest="50"
                    FontSize="16"
                    FontAttributes="Bold"
                    Grid.Column="1"
                    Clicked="OnNextClicked"/>

			<Button x:Name="FinishButton"
                    Text="Завершить"
                    BackgroundColor="#4CAF50"
                    TextColor="White"
                    CornerRadius="12"
                    HeightRequest="50"
                    FontSize="16"
                    FontAttributes="Bold"
                    IsVisible="False"
                    Grid.ColumnSpan="2"
                    Clicked="OnFinishClicked"/>
		</Grid>
	</Grid>
</ContentPage>