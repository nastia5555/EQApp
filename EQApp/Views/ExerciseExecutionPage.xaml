<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EQApp.Views.ExerciseExecutionPage"
             Title="Выполнение упражнения"
             BackgroundColor="#F8F9FA">

	<ScrollView>
		<VerticalStackLayout Spacing="15" Padding="20">

			<!-- Заголовок -->
			<Border StrokeThickness="0"
                    BackgroundColor="#4A90E2"
                    StrokeShape="RoundRectangle 15"
                    Padding="15">
				<VerticalStackLayout Spacing="5">
					<Label x:Name="TitleLabel"
                           Text=""
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="White"/>
					<Label x:Name="CategoryLabel"
                           Text=""
                           FontSize="13"
                           TextColor="White"
                           Opacity="0.9"/>
				</VerticalStackLayout>
			</Border>

			<!-- Инструкция -->
			<Border StrokeThickness="0"
                    BackgroundColor="#FFFFFF"
                    StrokeShape="RoundRectangle 12"
                    Padding="15"
                    Margin="0,0,0,10">
				<VerticalStackLayout Spacing="8">
					<Label Text="Инструкция"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="#2C3E50"/>
					<Label x:Name="InstructionLabel"
                           Text=""
                           FontSize="14"
                           TextColor="#4A5568"/>
				</VerticalStackLayout>
			</Border>

			<!-- Динамическая область -->
			<Border x:Name="InputBorder"
                    StrokeThickness="0"
                    BackgroundColor="#FFFFFF"
                    StrokeShape="RoundRectangle 12"
                    Padding="15"
                    Margin="0,0,0,10">
				<ScrollView>
					<VerticalStackLayout x:Name="InputArea" Spacing="10"/>
				</ScrollView>
			</Border>

			<!-- Кнопка завершения -->
			<Button x:Name="CompleteButton"
                    Text="Завершить упражнение"
                    BackgroundColor="#4CAF50"
					Clicked="OnCompleteClicked"
                    TextColor="White"
                    FontSize="16"
                    FontAttributes="Bold"
                    CornerRadius="12"
                    HeightRequest="55"
                    Margin="0,10,0,20"/>

		</VerticalStackLayout>
	</ScrollView>
</ContentPage>